# Discord bot token (required). DISCORD_TOKEN is also accepted.
BAMBOOZLEIFY_TOKEN=

# Optional:
# Sync commands to a single guild instantly (useful while developing).
# BAMBOOZLEIFY_GUILD_ID=000000000000000000
# SQLite database path (default: bamboozleify.db)
# BAMBOOZLEIFY_DB_PATH=bamboozleify.db
# Days before an anonymous message's author identity is purged (default: 30)
# BAMBOOZLEIFY_RETENTION_DAYS=30
